# Target -------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"

# Flash: 4 MB layout boots on both board revisions (V1: 4 MB, V2: 8 MB).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# PSRAM intentionally disabled: the app needs only a few KB of graphics RAM,
# and disabling it keeps one firmware compatible with V1 (quad) and V2 (octal).

# Serial console over the native USB-C port (USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Bluetooth: BLE only, NimBLE host ------------------------------------------
# Observer scans for the sensor; peripheral + broadcaster serve the GATT
# clock service during the setup window. No central role, no bonding.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
# Legacy advertising/scanning: the scanner parses BLE_GAP_EVENT_DISC.
CONFIG_BT_NIMBLE_EXT_ADV=n
# Otherwise a failed connection is re-advertised without a DISCONNECT event.
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# FreeRTOS -------------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000

# LVGL fonts used by the UI (the 72 px digits are in main/assets) -----------
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Power management ----------------------------------------------------------
# 80 MHz is plenty for BLE scanning and LVGL; idle time (e.g. waiting for the
# panel's BUSY line) is spent in automatic light sleep. BLE blocks light sleep
# while it runs, and so does a connected USB host, which keeps the serial
# console usable.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# Light sleep isolates all GPIOs (forced by the ESD reset workaround);
# board_init() exempts the battery latch and the panel pins.

# Deep sleep: shorter awake time per wake -----------------------------------
# Skip the app image hash check when waking from deep sleep.
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# SD card: month files like 2026-11.csv fit 8.3 names, no LFN needed.
CONFIG_FATFS_LFN_NONE=y

# The previous frame lives in RTC memory, not on this stack, but LVGL and
# NimBLE start-up still need more than the 3.5 kB default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Application-specific defaults (see main/Kconfig.projbuild)
CONFIG_APP_SENSOR_NAME_PREFIX="GV5171"
CONFIG_APP_FULL_REFRESH_EVERY=15
