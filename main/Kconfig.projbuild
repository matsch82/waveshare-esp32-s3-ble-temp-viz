menu "E-paper display application"

    config APP_SENSOR_NAME_PREFIX
        string "BLE advertised-name prefix of the Govee sensor"
        default "GV5171"
        help
            The sensor advertises as e.g. GV5171385C. The scanner does a
            case-insensitive substring match on this value.

    config APP_FULL_REFRESH_EVERY
        int "Full e-paper refresh every N display cycles"
        default 15
        range 1 1000
        help
            Number of scan/display cycles between full e-paper refreshes.
            Partial refreshes are used on all other cycles to reduce
            flicker. The first refresh after boot is always a full one.

endmenu
